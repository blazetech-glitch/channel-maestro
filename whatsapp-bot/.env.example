# ---- Server ----
PORT=3000
NODE_ENV=production
# Public base URL (used for secure cookies behind a proxy). Optional.
PUBLIC_URL=

# ---- Admin auth ----
ADMIN_USERNAME=admin
# Either a plaintext password (dev) ...
ADMIN_PASSWORD=change-me-please
# ... or a bcrypt hash (recommended). If set, it wins over ADMIN_PASSWORD.
# Generate with: npm run hash -- "your password"
ADMIN_PASSWORD_HASH=
# Long random string, e.g. openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# ---- WhatsApp ----
# Channel (newsletter) JID, always ends with @newsletter
# Example: 120363000000000000@newsletter
CHANNEL_JID=
# Folder where WhatsApp session credentials are stored (server-side only).
WA_AUTH_DIR=./data/wa-auth
# Minimum gap between two sends, to respect WhatsApp rate limits (ms)
MIN_SEND_INTERVAL_MS=5000

# ---- Storage ----
DB_PATH=./data/bot.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=32

# ---- Scheduling ----
# Default timezone for cron expressions (IANA name)
TIMEZONE=UTC
